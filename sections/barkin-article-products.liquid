{%- assign related_collection = section.settings.collection -%}
{%- if related_collection != blank -%}
  <section class="barkin-section barkin-article-products">
    <div class="barkin-centered-intro">
      <h2 class="barkin-title">{{ section.settings.heading | newline_to_br }}</h2>
      {%- if section.settings.text != blank -%}<p class="barkin-copy">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="barkin-button" href="{{ section.settings.button_link | default: related_collection.url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
    </div>
    <div class="barkin-shell barkin-article-products__grid">
      {%- for product in related_collection.products limit: section.settings.products_to_show -%}
        <article class="barkin-article-product-card">
          <a href="{{ product.url }}" class="barkin-article-product-card__image"><img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="704" height="704" loading="lazy"></a>
          <div class="barkin-article-product-card__body"><a href="{{ product.url }}">{{ product.title | escape }}</a><span>{{ product.price | money }}</span></div>
        </article>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Article related products",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Products collection" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Explore Products\nRelated To This Post." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Discover products selected to support your pet’s care routine." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop All Products" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 4, "step": 1, "default": 4, "label": "Products to show" }
  ],
  "presets": [{ "name": "Article related products" }]
}
{% endschema %}
