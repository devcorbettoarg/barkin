{%- liquid
  if article.image != blank
    assign hero_image = article.image | image_url: width: 2000
  else
    assign hero_image = 'blog-feature.webp' | asset_url
  endif
  assign author = article.metafields.custom.author.value
  if author == blank
    for author_entry in shop.metaobjects.author.values
      if author_entry.name.value == article.author
        assign author = author_entry
        break
      endif
    endfor
  endif
  if author != blank
    assign author_name = author.name.value | default: article.author
    assign author_subtitle = author.subtitle.value
    assign author_image = author.image.value
    assign author_text = author.text
  else
    assign author_name = article.author
    assign author_subtitle = article.tags.first | default: blog.title
    assign author_image = article.metafields.custom.author_image.value
    assign author_text = article.metafields.custom.author_bio.value | default: section.settings.author_bio
  endif
-%}

<article class="barkin-article">
  <div class="barkin-article__hero">
    <img src="{{ hero_image }}" alt="{{ article.image.alt | default: article.title | escape }}" width="1600" height="475" fetchpriority="high">
  </div>

  <div class="barkin-shell barkin-article__layout">
    <aside class="barkin-article__sidebar">
      <p class="barkin-article__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
      <h1 class="barkin-title">{{ article.title | escape }}</h1>
      <div class="barkin-article__author-card">
        <div class="barkin-article__author">
          {%- if author_image != blank -%}
            {{ author_image | image_url: width: 96 | image_tag: class: 'barkin-article__author-image', loading: 'lazy', widths: '48,96', alt: author_name }}
          {%- endif -%}
          <div><strong>{{ author_name | escape }}</strong>{% if author_subtitle != blank %}<span>{{ author_subtitle | escape }}</span>{% endif %}</div>
        </div>
        {%- if author_text != blank -%}
          <div class="barkin-article__author-bio">{% if author != blank %}{{ author_text | metafield_tag }}{% else %}{{ author_text | escape | newline_to_br }}{% endif %}</div>
        {%- endif -%}
      </div>
    </aside>

    <div class="barkin-article__content rte">
      {{ article.content }}
      <div class="barkin-article__share">
        {% assign share_url = request.origin | append: article.url %}
        {% render 'share-button', block: section, share_link: share_url %}
      </div>
    </div>
  </div>
</article>

<script type="application/ld+json">{{ article | structured_data }}</script>

{% schema %}
{
  "name": "Barkin article",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "textarea", "id": "author_bio", "label": "Fallback author bio", "info": "The Author metaobject in custom.author takes priority." },
    { "type": "text", "id": "share_label", "label": "Share label", "default": "Share This Post" }
  ],
  "presets": [{ "name": "Barkin article" }]
}
{% endschema %}
