{%- liquid
  assign selected_blog = section.settings.blog

  if selected_blog == blank
    assign selected_blog = blogs['news']
  endif

  assign feature_article = selected_blog.articles.first
-%}

<section class="barkin-section barkin-blog" data-node-id="20:1766">
  <div class="barkin-shell">

    <header class="barkin-blog__header">
      <h2 class="barkin-title">
        {{ section.settings.heading | newline_to_br }}
      </h2>

      <div class="barkin-blog__header-side">
        <p class="barkin-copy">
          {{ section.settings.text }}
        </p>

        {% if section.settings.button_label != blank %}
          <div>
            <a
              class="barkin-button barkin-button--outline"
              href="{{ selected_blog.url }}"
            >
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      </div>
    </header>


    {% if selected_blog != blank and selected_blog.articles.size > 0 %}

      <div class="barkin-blog__grid">

        {%- comment -%}
          ARTÍCULO MÁS RECIENTE
        {%- endcomment -%}

        {% if feature_article != blank %}
          <article class="barkin-blog-feature">

            {% if feature_article.image != blank %}
              {{
                feature_article.image
                | image_url: width: 1600
                | image_tag:
                  class: 'barkin-card-image',
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1600',
                  sizes: '(min-width: 990px) 60vw, 100vw',
                  alt: feature_article.title
              }}
            {% endif %}

            <div class="barkin-blog-feature__content">

              <h3 class="barkin-card-title">
                {{ feature_article.title }}
              </h3>

              <a
                class="barkin-button barkin-button--outline"
                href="{{ feature_article.url }}"
              >
                {{ section.settings.article_label }}
              </a>

            </div>
          </article>
        {% endif %}


        {%- comment -%}
          ARTÍCULOS 2, 3 Y 4
        {%- endcomment -%}

        <div class="barkin-blog-list">

          {% for article in selected_blog.articles limit: 3 offset: 1 %}

            <article class="barkin-blog-item">

              <div class="barkin-blog-item__content">

                {% if article.tags.first != blank %}
                  <p
                    class="barkin-copy"
                    style="color: rgba(255,253,252,.5)"
                  >
                    {{ article.tags.first }}
                  </p>
                {% endif %}

                <h3
                  class="barkin-product-card__title"
                  style="color: inherit"
                >
                  {{ article.title }}
                </h3>

                <a
                  class="barkin-button barkin-button--outline"
                  href="{{ article.url }}"
                >
                  {{ section.settings.article_label }}
                </a>

              </div>


              {% if article.image != blank %}

                {{
                  article.image
                    | image_url: width: 500
                    | image_tag:
                      loading: 'lazy',
                      widths: '250, 368, 500',
                      sizes: '368px',
                      alt: article.title
                }}

              {% endif %}

            </article>

          {% endfor %}

        </div>

      </div>

    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "Barkin blog guide",
  "tag": "section",
  "class": "section",

  "settings": [

    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Barkin&Meowson’s\nPet-Care Guide."
    },

    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Practical guides for healthier skin, better coats and happier pets."
    },

    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Header button label",
      "default": "View Full Blog"
    },

    {
      "type": "text",
      "id": "article_label",
      "label": "Article button label",
      "default": "Read Article"
    }

  ],

  "presets": [
    {
      "name": "Barkin blog guide"
    }
  ]
}
{% endschema %}