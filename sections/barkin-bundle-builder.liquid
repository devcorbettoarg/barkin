{{ 'barkin-theme.css' | asset_url | stylesheet_tag }}

<section class="barkin-section barkin-bundle" data-node-id="20:1765">
  <div class="barkin-shell">
    <div class="barkin-centered-intro">
      <h2 class="barkin-title">{{ section.settings.heading | newline_to_br }}</h2>
      <p class="barkin-copy">{{ section.settings.text }}</p>
      {% if section.settings.button_label != blank %}
        <a class="barkin-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
    <div class="barkin-bundle__grid">
      {% for block in section.blocks %}
        {%- liquid
          if block.settings.image != blank
            assign image_src = block.settings.image | image_url: width: 900
          else
            assign image_src = block.settings.fallback_asset | asset_url
          endif
        -%}
        <article class="barkin-bundle-card" {{ block.shopify_attributes }}>
          <div class="barkin-bundle-card__media">
            <img class="barkin-card-image" src="{{ image_src }}" alt="{{ block.settings.heading | escape }}" width="704" height="942" loading="lazy">
          </div>
          <div class="barkin-bundle-card__info">
            <h3 class="barkin-product-card__title">{{ block.settings.heading }}</h3>
            <p class="barkin-product-card__price">{{ block.settings.text }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Barkin bundle builder",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Build Your Pet's Routine,\nGet A Discount." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Add up to 6 products and save up to 15% on your bundle." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Build Your Bundle" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Bundle step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Design fallback",
          "default": "barkin/bundle-shampoo.png",
          "options": [
            { "value": "barkin/bundle-shampoo.png", "label": "Shampoo" },
            { "value": "barkin/bundle-conditioner.png", "label": "Conditioner" },
            { "value": "barkin/bundle-grooming.png", "label": "Grooming essentials" },
            { "value": "barkin/bundle-home.png", "label": "Home care" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shampoo" },
        { "type": "text", "id": "text", "label": "Text", "default": "Get your pet squeaky clean." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin bundle builder",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "fallback_asset": "barkin/bundle-conditioner.png", "heading": "Conditioner", "text": "Give them a beautifully soft coat." } },
        { "type": "step", "settings": { "fallback_asset": "barkin/bundle-grooming.png", "heading": "Grooming Essentials", "text": "The devil is in the details." } },
        { "type": "step", "settings": { "fallback_asset": "barkin/bundle-home.png", "heading": "Home Care", "text": "Easy cleanup, no hassle." } }
      ]
    }
  ]
}
{% endschema %}
