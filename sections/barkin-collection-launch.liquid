<script src="{{ 'barkin-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  if section.settings.left_image != blank
    assign left_image = section.settings.left_image | image_url: width: 1600
  else
    assign left_image = 'collection-summer.webp' | asset_url
  endif
-%}

<section class="barkin-section barkin-split" data-node-id="20:1760">
  <div class="barkin-shell barkin-split__grid">
    <article class="barkin-split-card barkin-split-card--dark">
      <img
        class="barkin-card-image"
        src="{{ left_image }}"
        alt="{{ section.settings.left_image.alt | default: section.settings.left_heading | escape }}"
        width="1430"
        height="1430"
        loading="lazy"
      >
      <div class="barkin-split-card__content">
        <h2 class="barkin-title">{{ section.settings.left_heading | newline_to_br }}</h2>
        {% if section.settings.left_text != blank %}
          <p class="barkin-copy">{{ section.settings.left_text }}</p>
        {% endif %}
        {% if section.settings.left_button_label != blank %}
          <div>
            <a class="barkin-button" href="{{ section.settings.left_link | default: routes.all_products_collection_url }}">
              {{ section.settings.left_button_label }}
            </a>
          </div>
        {% endif %}
      </div>
    </article>

    <barkin-carousel
      class="barkin-launch-carousel"
      data-carousel-edges="false"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.carousel_label | escape }}"
    >
      <div id="BarkinLaunchRail-{{ section.id }}" class="barkin-launch-carousel__rail" data-carousel-rail>
        {% for block in section.blocks %}
          {%- liquid
            assign card_product = block.settings.product
            if card_product != blank and card_product.featured_image != blank
              assign slide_image = card_product.featured_image | image_url: width: 1400
              assign product_title = card_product.title
              assign product_price = card_product.price | money
              assign product_url = card_product.url
            elsif block.settings.image != blank
              assign slide_image = block.settings.image | image_url: width: 1400
              assign product_title = block.settings.product_title
              assign product_price = block.settings.price
              assign product_url = block.settings.link
            else
              assign slide_image = block.settings.fallback_asset | asset_url
              assign product_title = block.settings.product_title
              assign product_price = block.settings.price
              assign product_url = block.settings.link
            endif
          -%}

          <article class="barkin-launch-slide" data-carousel-slide {{ block.shopify_attributes }}>
            <div class="barkin-launch-slide__header">
              <div>
                <h3 class="barkin-product-card__title">{{ product_title }}</h3>
                <p class="barkin-product-card__price">{{ product_price }}</p>
              </div>

              {% if card_product != blank %}
                {%- form 'product', card_product, class: 'barkin-launch-slide__form' -%}
                  <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
                  <button
                    class="barkin-launch-slide__bag"
                    type="submit"
                    aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product_title | escape }}"
                    {% unless card_product.available %}disabled{% endunless %}
                  >
                    <img src="{{ 'add-bag.svg' | asset_url }}" alt="" width="18" height="19">
                  </button>
                {%- endform -%}
              {% else %}
                <a
                  class="barkin-launch-slide__bag"
                  href="{{ product_url | default: routes.all_products_collection_url }}"
                  aria-label="{{ product_title | escape }}"
                >
                  <img src="{{ 'add-bag.svg' | asset_url }}" alt="" width="18" height="19">
                </a>
              {% endif %}
            </div>

            <a class="barkin-launch-slide__media" href="{{ product_url | default: routes.all_products_collection_url }}">
              <img src="{{ slide_image }}" alt="{{ product_title | escape }}" width="1430" height="1100" loading="lazy">
            </a>

            <div class="barkin-launch-slide__content">
              <h3 class="barkin-card-title">{{ block.settings.heading }}</h3>
              <p class="barkin-copy">{{ block.settings.text }}</p>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="barkin-launch-carousel__dots barkin-showcase__dots" role="group" aria-label="{{ section.settings.pagination_label | escape }}">
          {% for block in section.blocks %}
            <button
              class="barkin-showcase__dot{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-carousel-dot="{{ forloop.index0 }}"
              aria-label="Mostrar producto {{ forloop.index }}"
              aria-controls="BarkinLaunchRail-{{ section.id }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <span class="visually-hidden">{{ forloop.index }}</span>
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </barkin-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Barkin collection launch",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    { "type": "image_picker", "id": "left_image", "label": "Collection image" },
    { "type": "textarea", "id": "left_heading", "label": "Collection heading", "default": "Summer\nEssentials" },
    { "type": "textarea", "id": "left_text", "label": "Collection text", "default": "The care products you need to maintain impeccable hygiene and freshly scented company." },
    { "type": "text", "id": "left_button_label", "label": "Collection button label", "default": "View All Essentials" },
    { "type": "url", "id": "left_link", "label": "Collection link" },
    { "type": "text", "id": "carousel_label", "label": "Carousel accessibility label", "default": "Featured collection products" },
    { "type": "text", "id": "pagination_label", "label": "Pagination accessibility label", "default": "Choose featured product" }
  ],
  "blocks": [
    {
      "type": "product_slide",
      "name": "Product slide",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Fallback image" },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Design fallback",
          "default": "collection-product.webp",
          "options": [
            { "value": "collection-product.webp", "label": "White product" },
            { "value": "product-black.webp", "label": "Black product" },
            { "value": "product-spray.webp", "label": "Spray product" },
            { "value": "product-dental.webp", "label": "Dental product" }
          ]
        },
        { "type": "text", "id": "product_title", "label": "Fallback product title", "default": "Gentle Care Shampoo" },
        { "type": "text", "id": "price", "label": "Fallback price", "default": "$19.95" },
        { "type": "url", "id": "link", "label": "Fallback product link" },
        { "type": "text", "id": "heading", "label": "Slide heading", "default": "Easy Detangling" },
        { "type": "textarea", "id": "text", "label": "Slide text", "default": "Premium care for an easier, smoother grooming routine." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin collection launch",
      "blocks": [
        { "type": "product_slide" },
        { "type": "product_slide", "settings": { "fallback_asset": "product-black.webp", "product_title": "Gentle Care Shampoo", "heading": "Gentle Cleansing" } },
        { "type": "product_slide", "settings": { "fallback_asset": "product-spray.webp", "product_title": "Daily Care Spray", "heading": "Everyday Freshness" } },
        { "type": "product_slide", "settings": { "fallback_asset": "product-dental.webp", "product_title": "Dental Essentials", "heading": "Daily Dental Care" } },
        { "type": "product_slide", "settings": { "fallback_asset": "collection-product.webp", "product_title": "Moisturising Conditioner", "heading": "Soft, Healthy Coats" } }
      ]
    }
  ]
}
{% endschema %}
