<footer class="barkin-site-footer">
  <div class="barkin-site-footer__grid">
    <a class="barkin-site-footer__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 520
          | image_tag: widths: '180,260,360,520', width: section.settings.logo_width, alt: shop.name
        }}
      {% else %}
        <span class="barkin-site-footer__mark">♚</span>
        <span class="barkin-site-header__logo-kicker">{{ section.settings.logo_kicker }}</span>
        <span class="barkin-site-footer__logo-text">{{ section.settings.logo_text }}</span>
      {% endif %}
    </a>

    <div class="barkin-site-footer__newsletter">
      <h2>{{ section.settings.newsletter_heading }}</h2>
      <p>{{ section.settings.newsletter_text }}</p>
      {% form 'customer', class: 'barkin-site-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="BarkinFooterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
        <input
          id="BarkinFooterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ 'newsletter.label' | t }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
        >
        <button type="submit" aria-label="{{ 'newsletter.button_label' | t }}">›</button>
      {% endform %}
      {% if shop.enabled_payment_types != empty %}
        <ul class="barkin-site-footer__payments" role="list">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    {% for block in section.blocks %}
      <div class="barkin-site-footer__column" {{ block.shopify_attributes }}>
        <h2>{{ block.settings.heading }}</h2>
        {% if block.type == 'menu' %}
          <ul role="list">
            {% for link in block.settings.menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="rte">{{ block.settings.content }}</div>
          {% if block.settings.show_social %}
            <ul class="barkin-site-footer__social" role="list">
              {% if settings.social_instagram_link != blank %}<li><a href="{{ settings.social_instagram_link }}">Instagram</a></li>{% endif %}
              {% if settings.social_tiktok_link != blank %}<li><a href="{{ settings.social_tiktok_link }}">TikTok</a></li>{% endif %}
              {% if settings.social_youtube_link != blank %}<li><a href="{{ settings.social_youtube_link }}">Youtube</a></li>{% endif %}
            </ul>
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
  <p class="barkin-site-footer__copyright">© {{ 'now' | date: '%Y' }} {{ section.settings.copyright }}</p>
</footer>

{% schema %}
{
  "name": "Barkin footer",
  "tag": "section",
  "class": "section-footer",
  "max_blocks": 3,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "min": 120, "max": 300, "step": 10, "unit": "px", "label": "Logo width", "default": 220 },
    { "type": "text", "id": "logo_kicker", "label": "Fallback logo small text", "default": "Royale's Care" },
    { "type": "text", "id": "logo_text", "label": "Fallback logo text", "default": "& BARKIN MEOWSON" },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Subscribe our Newsletter" },
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter text", "default": "You will be kept up to date with all our latest news." },
    { "type": "text", "id": "copyright", "label": "Copyright name", "default": "Barkin&Meowson" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Directory" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Connect" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>+34 623 78 46 04<br>Email Address</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "presets": [
    {
      "name": "Barkin footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Directory" } },
        { "type": "text", "settings": { "heading": "Connect" } },
        { "type": "menu", "settings": { "heading": "Resources" } }
      ]
    }
  ]
}
{% endschema %}
