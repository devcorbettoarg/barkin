<section class="barkin-section barkin-guarantees" data-node-id="20:1761">
  <div class="barkin-shell barkin-guarantees__layout">
    <div class="barkin-guarantees__intro">
      <h2 class="barkin-title">{{ section.settings.heading | newline_to_br }}</h2>
      <p class="barkin-copy">{{ section.settings.text }}</p>
    </div>
    <div class="barkin-guarantees__list">
      {% for block in section.blocks %}
        <article class="barkin-guarantee" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.icon | asset_url }}" alt="" width="84" height="84" loading="lazy">
          <div>
            <h3 class="barkin-card-title">{{ block.settings.heading }}</h3>
            <p class="barkin-guarantee__copy">{{ block.settings.text }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Barkin guarantees",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Premium Product\nGuarantees" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Premium care made with the health of your pet and the planet in mind." }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Guarantee",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "guarantee-cruelty-free.svg",
          "options": [
            { "value": "guarantee-cruelty-free.svg", "label": "Cruelty free" },
            { "value": "guarantee-paraben-free.svg", "label": "Paraben free" },
            { "value": "guarantee-gmp.svg", "label": "GMP" },
            { "value": "guarantee-vet.svg", "label": "Vet recommended" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Always Cruelty Free." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Thoughtful formulas created without animal testing." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin guarantees",
      "blocks": [
        { "type": "guarantee" },
        { "type": "guarantee", "settings": { "icon": "guarantee-paraben-free.svg", "heading": "Paraben & Sulfate Free." } },
        { "type": "guarantee", "settings": { "icon": "guarantee-gmp.svg", "heading": "GMP Certified." } },
        { "type": "guarantee", "settings": { "icon": "guarantee-vet.svg", "heading": "Vet Recommended." } }
      ]
    }
  ]
}
{% endschema %}
