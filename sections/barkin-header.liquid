<div class="barkin-site-header">
  {% if section.settings.announcement != blank %}
    <div class="barkin-site-header__announcement">{{ section.settings.announcement }}</div>
  {% endif %}

  <header class="barkin-site-header__main">
    <details class="barkin-site-header__mobile-menu">
      <summary aria-label="{{ 'sections.header.menu' | t }}">
        <img src="{{ 'icon-hamburger.svg' | asset_url }}" alt="" width="20" height="20">
      </summary>
      <nav>
        {% for link in section.settings.menu.links %}
          {% if link.links != blank %}
            <details>
              <summary>{{ link.title }} <span aria-hidden="true">+</span></summary>
              <div>
                <a href="{{ link.url }}">View all {{ link.title }}</a>
                {% for child_link in link.links %}
                  <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                  {% for grandchild_link in child_link.links %}
                    <a class="barkin-site-header__mobile-grandchild" href="{{ grandchild_link.url }}">
                      {{ grandchild_link.title }}
                    </a>
                  {% endfor %}
                {% endfor %}
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    </details>

    <nav class="barkin-site-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      {% for link in section.settings.menu.links %}
        <div class="barkin-site-header__nav-item">
          <a href="{{ link.url }}">
            {{ link.title }}
            {% if link.links != blank %}<span aria-hidden="true">⌄</span>{% endif %}
          </a>

          {% if link.links != blank %}
            <div class="barkin-site-header__mega">
              <div class="barkin-site-header__mega-inner">
                <div class="barkin-site-header__mega-links">
                  {% for child_link in link.links %}
                    <div class="barkin-site-header__mega-column">
                      <a class="barkin-site-header__mega-heading" href="{{ child_link.url }}">{{ child_link.title }}</a>
                      {% for grandchild_link in child_link.links %}
                        <a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                      {% endfor %}
                    </div>
                  {% endfor %}
                </div>

                <div class="barkin-site-header__mega-products">
                  {% for i in (1..2) %}
                    {%- liquid
                      assign product_setting_id = 'mega_product_' | append: i
                      assign mega_product = section.settings[product_setting_id]
                    -%}
                    {% if mega_product != blank %}
                      <article class="barkin-site-header__mega-product">
                        <a href="{{ mega_product.url }}">
                          <span class="barkin-site-header__mega-product-media">
                            {% if mega_product.featured_image != blank %}
                              {{
                                mega_product.featured_image
                                | image_url: width: 600
                                | image_tag: loading: 'lazy', widths: '240,360,480,600', alt: mega_product.title
                              }}
                            {% endif %}
                          </span>
                          <span class="barkin-site-header__mega-product-info">
                            <span>
                              <strong>{{ mega_product.title }}</strong>
                              <small>{{ mega_product.price | money }}</small>
                            </span>
                          </span>
                        </a>
                        {% form 'product', mega_product, class: 'barkin-site-header__mega-product-form' %}
                          <input type="hidden" name="id" value="{{ mega_product.selected_or_first_available_variant.id }}">
                          <button
                            type="submit"
                            aria-label="{{ 'products.product.add_to_cart' | t }}: {{ mega_product.title | escape }}"
                            {% unless mega_product.available %}disabled{% endunless %}
                          >
                            <img src="{{ 'barkin/add-bag.svg' | asset_url }}" alt="" width="18" height="19">
                          </button>
                        {% endform %}
                      </article>
                    {% endif %}
                  {% endfor %}
                  {% if section.settings.mega_product_1 == blank and section.settings.mega_product_2 == blank %}
                    <div class="barkin-site-header__mega-empty">
                      Select two featured products in the Barkin header settings.
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    <a class="barkin-site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 520
          | image_tag: widths: '180,260,360,520', width: section.settings.logo_width, alt: shop.name
        }}
      {% else %}
        <span class="barkin-site-header__logo-kicker">{{ section.settings.logo_kicker }}</span>
        <span class="barkin-site-header__logo-text">{{ section.settings.logo_text }}</span>
      {% endif %}
    </a>

    <div class="barkin-site-header__actions">
      <span class="barkin-site-header__currency" aria-label="{{ localization.country.currency.iso_code }}">
        {{ localization.country.currency.symbol }}⌄
      </span>
      <a href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
        <img src="{{ 'icon-search.svg' | asset_url }}" alt="" width="20" height="20">
      </a>
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" aria-label="{{ 'customer.account_fallback' | t }}">
          <img src="{{ 'icon-account.svg' | asset_url }}" alt="" width="20" height="20">
        </a>
      {% endif %}
      {%- liquid
        assign cart_icon = 'icon-cart-empty.svg'
        unless cart == empty
          assign cart_icon = 'icon-cart.svg'
        endunless
      -%}
      <a href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}">
        <img
          src="{{ cart_icon | asset_url }}"
          alt=""
          width="20"
          height="20"
        >
        {% if cart.item_count > 0 %}<span class="visually-hidden">{{ cart.item_count }}</span>{% endif %}
      </a>
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Barkin header",
  "tag": "section",
  "class": "section-header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "Free shipping above $35 on all US orders" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "min": 120, "max": 320, "step": 10, "unit": "px", "label": "Logo width", "default": 240 },
    { "type": "text", "id": "logo_kicker", "label": "Fallback logo small text", "default": "Royale's Care" },
    { "type": "text", "id": "logo_text", "label": "Fallback logo text", "default": "BARKIN&MEOWSON" },
    { "type": "header", "content": "Mega menu products" },
    { "type": "product", "id": "mega_product_1", "label": "Featured product 1" },
    { "type": "product", "id": "mega_product_2", "label": "Featured product 2" }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    { "name": "Barkin header" }
  ]
}
{% endschema %}
