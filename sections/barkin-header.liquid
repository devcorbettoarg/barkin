<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'barkin-mega-menu.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'barkin-sticky-header.js' | asset_url }}" defer="defer"></script>

<barkin-sticky-header class="barkin-site-header{% if request.page_type == 'product' %} barkin-site-header--pdp{% endif %}">
  {% if section.settings.announcement != blank %}
    <div class="barkin-site-header__announcement">{{ section.settings.announcement }}</div>
  {% endif %}

  <header
    class="barkin-site-header__main"
    style="--barkin-mobile-logo-width: {{ section.settings.mobile_logo_width }}px;"
  >
    <details class="barkin-site-header__mobile-menu">
      <summary aria-label="{{ 'sections.header.menu' | t }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </summary>
      <nav class="barkin-mobile-panel" aria-label="{{ 'sections.header.menu' | t }}">
        <div class="barkin-mobile-links">
          {%- assign featured_link = section.settings.menu.links.first -%}
          {% for link in section.settings.menu.links %}
            {% if link.handle == 'shop' %}{% assign featured_link = link %}{% endif %}
          {% endfor %}
          {% for link in section.settings.menu.links %}
            {% if link == featured_link %}
              <div class="barkin-mobile-shop">
                <a class="barkin-mobile-row barkin-mobile-shop-title" href="{{ link.url }}">{{ link.title | escape }}</a>
                {% if link.links != blank %}
                  <details class="barkin-mobile-categories" open>
                    <summary>Our Products <span class="barkin-mobile-chevron" aria-hidden="true"></span></summary>
                    <div class="barkin-mobile-category-grid">
                      <div class="barkin-mobile-category-column">
                        <a class="barkin-mobile-shop-all" href="{{ link.url }}">Shop All Products</a>
                        {% for child_link in link.links %}
                          {% if child_link.links == blank %}
                            <a href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
                          {% endif %}
                        {% endfor %}
                      </div>
                      {% for child_link in link.links %}
                        {% if child_link.links != blank %}
                          <div class="barkin-mobile-category-column">
                            <a class="barkin-mobile-category-heading" href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
                            {% for grandchild_link in child_link.links %}
                              <a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a>
                            {% endfor %}
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </details>
                {% endif %}
                {% if section.settings.mega_product_1 != blank or section.settings.mega_product_2 != blank %}
                  <div class="barkin-mobile-products">
                    {% for i in (1..2) %}
                      {%- liquid
                        assign product_setting_id = 'mega_product_' | append: i
                        assign mobile_product = section.settings[product_setting_id]
                      -%}
                      {% if mobile_product != blank %}
                        <a class="barkin-mobile-product" href="{{ mobile_product.url }}">
                          {% if mobile_product.featured_image != blank %}
                            {{ mobile_product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120,180,240,360', sizes: '(max-width: 749px) calc((100vw - 52px) / 2), 160px', alt: '' }}
                          {% endif %}
                          <span>
                            <strong>{{ mobile_product.title | escape }}</strong>
                            <small>{{ mobile_product.price | money }}</small>
                          </span>
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% elsif link.links != blank %}
              <details class="barkin-mobile-section">
                <summary>{{ link.title | escape }} <span class="barkin-mobile-chevron" aria-hidden="true"></span></summary>
                <div class="barkin-mobile-category-grid">
                  <div class="barkin-mobile-category-column">
                    <a class="barkin-mobile-category-heading" href="{{ link.url }}">View all {{ link.title | escape }}</a>
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
                      {% for grandchild_link in child_link.links %}
                        <a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a>
                      {% endfor %}
                    {% endfor %}
                  </div>
                </div>
              </details>
            {% else %}
              <a class="barkin-mobile-row" href="{{ link.url }}">{{ link.title | escape }}</a>
            {% endif %}
          {% endfor %}
        </div>
        <div class="barkin-mobile-footer">
          <small class="barkin-mobile-copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</small>
          {% if section.settings.enable_country_selector and localization.available_countries.size > 1 %}
            {% assign mobile_country_id = 'BarkinMobileCountry-' | append: section.id %}
            {% form 'localization', id: mobile_country_id, class: 'barkin-mobile-localization' %}
              <label class="visually-hidden" for="{{ mobile_country_id }}Select">{{ 'localization.country_label' | t }}</label>
              <select id="{{ mobile_country_id }}Select" name="country_code" data-mobile-country>
                {% for country in localization.available_countries %}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.currency.symbol }} · {{ country.name | escape }} ({{ country.currency.iso_code }})
                  </option>
                {% endfor %}
              </select>
              <span class="barkin-mobile-chevron" aria-hidden="true"></span>
              <noscript><button type="submit">{{ 'localization.update_country' | t }}</button></noscript>
            {% endform %}
          {% endif %}
          <details class="barkin-mobile-search-toggle">
            <summary aria-label="{{ 'general.search.search' | t }}">
              <span class="barkin-mobile-search-icon" aria-hidden="true">
                <img class="barkin-mobile-search-circle" src="{{ 'barkin-mobile-search-circle.svg' | asset_url }}" alt="" width="14.6174" height="14.6174">
                <img class="barkin-mobile-search-handle" src="{{ 'barkin-mobile-search-handle.svg' | asset_url }}" alt="" width="5.92174" height="5.92174">
              </span>
            </summary>
            <form class="barkin-mobile-search" action="{{ routes.search_url }}" method="get" role="search">
              <label class="visually-hidden" for="BarkinMobileSearch-{{ section.id }}">{{ 'general.search.search' | t }}</label>
              <input id="BarkinMobileSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.search' | t }}">
              <input type="hidden" name="options[prefix]" value="last">
              <button type="submit">{{ 'general.search.search' | t }}</button>
            </form>
          </details>
          {% if shop.customer_accounts_enabled %}
            <a class="barkin-mobile-account" href="{{ routes.account_url }}" aria-label="My account" title="My account">
              <span class="barkin-mobile-account-icon" aria-hidden="true">
                <img class="barkin-mobile-account-head" src="{{ 'barkin-mobile-account-head.svg' | asset_url }}" alt="" width="8.44002" height="8.44002">
                <img class="barkin-mobile-account-body" src="{{ 'barkin-mobile-account-body.svg' | asset_url }}" alt="" width="15.0671" height="7.15982">
              </span>
              <span class="visually-hidden">My account</span>
            </a>
          {% endif %}
        </div>
      </nav>
    </details>

    <nav class="barkin-site-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <barkin-desktop-mega-menu>
            <details class="barkin-site-header__nav-item">
              <summary aria-expanded="false" aria-controls="BarkinMegaMenu-{{ section.id }}-{{ forloop.index }}">
                <span>{{ link.title }}</span>
                <span class="menuarrow" aria-hidden="true">⌄</span>
              </summary>

              <div id="BarkinMegaMenu-{{ section.id }}-{{ forloop.index }}" class="barkin-site-header__mega">
              <div class="barkin-site-header__mega-inner">
                <div class="barkin-site-header__mega-content">
                  <div class="barkin-site-header__mega-intro">
                    {% if section.settings.mega_title != blank %}
                      <h2>{{ section.settings.mega_title }}</h2>
                    {% endif %}
                    {% if section.settings.mega_text != blank %}
                      <p>{{ section.settings.mega_text }}</p>
                    {% endif %}
                  </div>

                  <div class="barkin-site-header__mega-links">
                    {% for child_link in link.links %}
                      <div class="barkin-site-header__mega-column">
                        <a class="barkin-site-header__mega-heading" href="{{ child_link.url }}">{{ child_link.title }}</a>
                        {% for grandchild_link in child_link.links %}
                          <a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                        {% endfor %}
                      </div>
                    {% endfor %}
                  </div>
                </div>

                <div class="barkin-site-header__mega-products">
                  {% for i in (1..2) %}
                    {%- liquid
                      assign product_setting_id = 'mega_product_' | append: i
                      assign mega_product = section.settings[product_setting_id]
                    -%}
                    {% if mega_product != blank %}
                      <article class="barkin-site-header__mega-product">
                        <a href="{{ mega_product.url }}">
                          <span class="barkin-site-header__mega-product-media">
                            {% if mega_product.featured_image != blank %}
                              {{
                                mega_product.featured_image
                                | image_url: width: 600
                                | image_tag: loading: 'lazy', widths: '240,360,480,600', alt: mega_product.title
                              }}
                            {% endif %}
                          </span>
                          <span class="barkin-site-header__mega-product-info">
                            <span>
                              <strong>{{ mega_product.title }}</strong>
                              <small>{{ mega_product.price | money }}</small>
                            </span>
                          </span>
                        </a>
                        <product-form>
                        <div class="product-form__error-message-wrapper barkin-card-add-error" role="alert" hidden><span class="product-form__error-message"></span></div>
                        {%- assign mega_form_id = 'BarkinMegaForm-' | append: section.id | append: '-' | append: i -%}
                        {% form 'product', mega_product, id: mega_form_id, class: 'barkin-site-header__mega-product-form' %}
                          <input type="hidden" name="id" value="{{ mega_product.selected_or_first_available_variant.id }}">
                          <button
                            type="submit"
                            aria-label="{{ 'products.product.add_to_cart' | t }}: {{ mega_product.title | escape }}"
                            {% unless mega_product.available %}disabled{% endunless %}
                          >
                            <span><img src="{{ 'barkin-card-bag.svg' | asset_url }}" alt="" width="18" height="20"></span>
                            {%- render 'loading-spinner' -%}
                          </button>
                        {% endform %}
                        </product-form>
                      </article>
                    {% endif %}
                  {% endfor %}
                  {% if section.settings.mega_product_1 == blank and section.settings.mega_product_2 == blank %}
                    <div class="barkin-site-header__mega-empty">
                      Select two featured products in the Barkin header settings.
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
            </details>
          </barkin-desktop-mega-menu>
        {% else %}
          <div class="barkin-site-header__nav-item">
            <a href="{{ link.url }}">{{ link.title }}</a>
          </div>
        {% endif %}
      {% endfor %}
    </nav>

    <a class="barkin-site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 520
          | image_tag: widths: '180,260,360,520', width: section.settings.logo_width, alt: shop.name
        }}
      {% else %}
        <span class="barkin-site-header__logo-kicker">{{ section.settings.logo_kicker }}</span>
        <span class="barkin-site-header__logo-text">{{ section.settings.logo_text }}</span>
      {% endif %}
    </a>

    <div class="barkin-site-header__actions">
      {% if section.settings.enable_country_selector and localization.available_countries.size > 1 %}
        {% assign country_selector_id = 'BarkinHeaderCountry-' | append: section.id %}
        <div class="barkin-site-header__currency header-localization">
          <localization-form>
            {% form 'localization', id: country_selector_id, class: 'localization-form' %}
              <div>
                <h2 class="visually-hidden" id="{{ country_selector_id }}Label">{{ 'localization.country_label' | t }}</h2>
                {% render 'country-localization', localPosition: country_selector_id %}
              </div>
            {% endform %}
          </localization-form>
        </div>
      {% endif %}
      <a class="barkin-site-header__search" href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/>
        </svg>
      </a>
      {% if shop.customer_accounts_enabled %}
        <a class="barkin-site-header__account" href="{{ routes.account_url }}" aria-label="{{ 'customer.account_fallback' | t }}">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/>
          </svg>
        </a>
      {% endif %}
      <a class="barkin-site-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}">
        <svg aria-hidden="true" width="17" height="18" viewBox="0 0 17 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6.8584 0.700195H9.50632C10.2077 0.700195 10.8808 0.981236 11.3779 1.48074C11.8749 1.98214 12.1536 2.66041 12.1531 3.36724V5.14451H4.2116V3.36724C4.2116 2.65952 4.49081 1.98138 4.9868 1.48074C5.23236 1.2335 5.52419 1.03728 5.84556 0.903338C6.16692 0.769395 6.5115 0.700362 6.85953 0.700195M0.699951 5.14451H15.7V14.2653C15.7 14.9104 15.4457 15.5305 14.9917 15.9868C14.5377 16.4442 13.9237 16.7002 13.2824 16.7002H3.11748C2.79978 16.6997 2.48529 16.6364 2.192 16.514C1.89871 16.3916 1.63236 16.2125 1.40818 15.9868C0.954952 15.529 0.700411 14.9103 0.699951 14.2653V5.14451Z" stroke="#FFFDFC" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="barkin-site-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </header>
</barkin-sticky-header>

{% schema %}
{
  "name": "Barkin header",
  "tag": "section",
  "class": "section-header barkin-header-section",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "Free shipping above $35 on all US orders" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "enable_country_selector", "default": true, "label": "t:sections.header.settings.enable_country_selector.label", "info": "t:sections.header.settings.enable_country_selector.info" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "min": 120, "max": 320, "step": 10, "unit": "px", "label": "Logo width", "default": 240 },
    { "type": "range", "id": "mobile_logo_width", "min": 140, "max": 220, "step": 10, "unit": "px", "label": "Mobile logo width", "default": 180 },
    { "type": "text", "id": "logo_kicker", "label": "Fallback logo small text", "default": "Royale's Care" },
    { "type": "text", "id": "logo_text", "label": "Fallback logo text", "default": "BARKIN&MEOWSON" },
    { "type": "text", "id": "mega_title", "label": "Mega menu title", "default": "Premium Petcare Products." },
    { "type": "textarea", "id": "mega_text", "label": "Mega menu description", "default": "Discover premium grooming and care products thoughtfully selected for healthier, happier pets." },
    { "type": "header", "content": "Mega menu products" },
    { "type": "product", "id": "mega_product_1", "label": "Featured product 1" },
    { "type": "product", "id": "mega_product_2", "label": "Featured product 2" }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    { "name": "Barkin header" }
  ]
}
{% endschema %}
