{%- liquid
  assign fallback_asset = section.settings.fallback_asset | default: 'barkin/hero-shopping.png'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  if section.settings.image != blank
    assign hero_src = section.settings.image | image_url: width: 2400
  else
    assign hero_src = fallback_asset | asset_url
  endif
-%}

<section
  class="barkin-hero{% if section.settings.mobile_only %} barkin-hero--mobile-only{% endif %}{% if section.settings.desktop_only %} barkin-hero--desktop-only{% endif %}"
  style="--barkin-hero-height: {{ section.settings.desktop_height }}px; --barkin-hero-mobile-height: {{ section.settings.mobile_height | default: 650 }}px;"
  data-node-id="{{ section.settings.figma_node }}"
>
  <img
    class="barkin-hero__image"
    src="{{ hero_src }}"
    alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
    width="2400"
    height="{{ section.settings.desktop_height }}"
    loading="{% if section.index == 1 %}eager{% else %}lazy{% endif %}"
    {% if section.index == 1 %}fetchpriority="high"{% endif %}
  >
  <div class="barkin-hero__content">
    <{{ heading_tag }} class="barkin-title">{{ section.settings.heading | newline_to_br }}</{{ heading_tag }}>
    {% if section.settings.text != blank %}
      <div class="barkin-copy">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <div>
        <a class="barkin-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Barkin hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "figma_node", "label": "Figma node", "default": "20:1757" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "fallback_asset",
      "label": "Design fallback",
      "default": "barkin/hero-shopping.png",
      "options": [
        { "value": "barkin/hero-shopping.png", "label": "Shopping hero" },
        { "value": "barkin/hero-household.png", "label": "Household hero" },
        { "value": "barkin/hero-quiz.png", "label": "Product quiz hero" }
      ]
    },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Shopping for\nPremium Products" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "default": "h2", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }] },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "An exquisite collection of grooming and home care for discerning pets and their parents."
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "desktop_height", "min": 500, "max": 1000, "step": 25, "unit": "px", "label": "Desktop height", "default": 875 },
    { "type": "range", "id": "mobile_height", "min": 300, "max": 1000, "step": 1, "unit": "px", "label": "Mobile height", "default": 650 },
    { "type": "checkbox", "id": "mobile_only", "label": "Show only on mobile", "default": false },
    { "type": "checkbox", "id": "desktop_only", "label": "Show only on desktop", "default": false }
  ],
  "presets": [{ "name": "Barkin hero" }]
}
{% endschema %}
