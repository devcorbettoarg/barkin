<script src="{{ 'barkin-carousel.js' | asset_url }}" defer="defer"></script>

<section class="barkin-section barkin-mosaic" data-node-id="20:1762">
  <div class="barkin-shell">
    <header class="barkin-mosaic__header">
      <h2 class="barkin-title">{{ section.settings.heading | newline_to_br }}</h2>
      <div class="barkin-mosaic__side">
        <p class="barkin-copy">{{ section.settings.text }}</p>
        {% if section.settings.button_label != blank %}
          <div><a class="barkin-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>
        {% endif %}
      </div>
    </header>
    {%- assign mobile_slide_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'image' -%}
        {%- assign mobile_slide_count = mobile_slide_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    <barkin-carousel
      class="barkin-mosaic__carousel"
      data-carousel-edges="false"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.pagination_label | escape }}"
    >
    <div id="BarkinIngredientsRail-{{ section.id }}" class="barkin-mosaic__grid" data-carousel-rail>
      {%- assign mobile_image_column = 0 -%}
      {%- assign mobile_text_column = 0 -%}
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          {%- liquid
            assign mobile_image_column = mobile_image_column | plus: 1
            if block.settings.image != blank
              assign image_src = block.settings.image | image_url: width: 900
            else
              assign image_src = block.settings.fallback_asset | asset_url
            endif
          -%}
          <div
            class="barkin-mosaic-card barkin-mosaic-card--image"
            style="--barkin-mobile-mosaic-column: {{ mobile_image_column }};"
            data-carousel-slide
            {{ block.shopify_attributes }}
          >
            <img class="barkin-card-image" src="{{ image_src }}" alt="{{ block.settings.alt | escape }}" width="704" height="704" loading="lazy">
          </div>
        {% else %}
          {%- assign mobile_text_column = mobile_text_column | plus: 1 -%}
          <article
            class="barkin-mosaic-card barkin-mosaic-card--text"
            style="--barkin-mobile-mosaic-column: {{ mobile_text_column }};"
            {{ block.shopify_attributes }}
          >
            <h3 class="barkin-card-title">{{ block.settings.heading | newline_to_br }}</h3>
            <p class="barkin-copy">{{ block.settings.text }}</p>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if mobile_slide_count > 1 %}
      <div class="barkin-showcase__dots barkin-mosaic__dots" role="group" aria-label="{{ section.settings.pagination_label | escape }}">
        {%- assign mobile_dot_index = 0 -%}
        {% for block in section.blocks %}
          {% if block.type == 'image' %}
            <button
              class="barkin-showcase__dot{% if mobile_dot_index == 0 %} is-active{% endif %}"
              type="button"
              data-carousel-dot="{{ mobile_dot_index }}"
              aria-label="Ingredient {{ mobile_dot_index | plus: 1 }}"
              aria-controls="BarkinIngredientsRail-{{ section.id }}"
              aria-current="{% if mobile_dot_index == 0 %}true{% else %}false{% endif %}"
            >
              <span class="visually-hidden">{{ mobile_dot_index | plus: 1 }}</span>
            </button>
            {%- assign mobile_dot_index = mobile_dot_index | plus: 1 -%}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    </barkin-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Barkin ingredients",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Human Grade\nIngredients" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choosing premium ingredients helps support healthy skin and a beautiful coat." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn More" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "pagination_label", "label": "Pagination accessibility label", "default": "Choose ingredient slide" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Design fallback",
          "default": "ingredient-honey.webp",
          "options": [
            { "value": "ingredient-honey.webp", "label": "Honey" },
            { "value": "ingredient-bubbles.webp", "label": "Bubbles" },
            { "value": "ingredient-dropper.webp", "label": "Dropper" },
            { "value": "ingredient-microscope.webp", "label": "Microscope" }
          ]
        },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Premium ingredient" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Premium Grade\nIngredient" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The care products you need to maintain impeccable hygiene and a healthy coat." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin ingredients",
      "blocks": [
        { "type": "image", "settings": { "fallback_asset": "ingredient-honey.webp" } },
        { "type": "text" },
        { "type": "image", "settings": { "fallback_asset": "ingredient-bubbles.webp" } },
        { "type": "text" },
        { "type": "text" },
        { "type": "image", "settings": { "fallback_asset": "ingredient-dropper.webp" } },
        { "type": "text" },
        { "type": "image", "settings": { "fallback_asset": "ingredient-microscope.webp" } }
      ]
    }
  ]
}
{% endschema %}
