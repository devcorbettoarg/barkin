<script src="{{ 'barkin-carousel.js' | asset_url }}" defer="defer"></script>

<section class="barkin-section barkin-mosaic" data-node-id="20:1762">
  <div class="barkin-shell">
    <header class="barkin-mosaic__header">
      <h2 class="barkin-title">
        {%- if section.settings.product_heading != blank -%}
          {{- section.settings.product_heading | escape -}}
        {%- else -%}
          {{- section.settings.heading | escape | newline_to_br -}}
        {%- endif -%}
      </h2>
      <div class="barkin-mosaic__side">
        <div class="barkin-copy barkin-mosaic__intro-copy">
          {%- if section.settings.product_text != blank -%}
            {{- section.settings.product_text -}}
          {%- else -%}
            <p>{{ section.settings.text | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
        {% if section.settings.button_label != blank %}
          <div><a class="barkin-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>
        {% endif %}
      </div>
    </header>
    {%- assign mobile_slide_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'image' or block.type == 'ingredient' -%}
        {%- assign mobile_slide_count = mobile_slide_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    <barkin-carousel
      class="barkin-mosaic__carousel"
      data-carousel-edges="false"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.pagination_label | escape }}"
    >
    <div id="BarkinIngredientsRail-{{ section.id }}" class="barkin-mosaic__grid" data-carousel-rail>
      {%- assign mobile_image_column = 0 -%}
      {%- assign mobile_text_column = 0 -%}
      {% for block in section.blocks %}
        {% if block.type == 'ingredient' %}
          {%- liquid
            assign ingredient = block.settings.ingredient
            assign ingredient_heading = ingredient.title.value | default: block.settings.heading
            assign ingredient_text = ingredient.text
            assign ingredient_image = ingredient.image.value | default: block.settings.image
            assign ingredient_column = mobile_image_column | at_least: mobile_text_column | plus: 1
            assign mobile_image_column = ingredient_column
            assign mobile_text_column = ingredient_column
          -%}
          <article class="barkin-ingredient" style="--barkin-mobile-mosaic-column: {{ ingredient_column }};" {{ block.shopify_attributes }}>
            <div class="barkin-mosaic-card barkin-mosaic-card--image" data-carousel-slide>
              {% if ingredient_image != blank %}
                {{ ingredient_image | image_url: width: 900 | image_tag: class: 'barkin-card-image', loading: 'lazy', widths: '360,540,720,900', alt: ingredient_heading }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'barkin-card-image' }}
              {% endif %}
            </div>
            <div class="barkin-mosaic-card barkin-mosaic-card--text">
              <h3 class="barkin-card-title">{{ ingredient_heading | escape | newline_to_br }}</h3>
              <div class="barkin-copy barkin-ingredient__copy">
                {% if ingredient_text.value != blank %}
                  {% if ingredient_text.type == 'rich_text_field' %}
                    {{ ingredient_text | metafield_tag }}
                  {% else %}
                    <p>{{ ingredient_text.value | escape | newline_to_br }}</p>
                  {% endif %}
                {% else %}
                  {{ block.settings.text }}
                {% endif %}
              </div>
            </div>
          </article>
        {% elsif block.type == 'image' %}
          {%- liquid
            assign mobile_image_column = mobile_image_column | plus: 1
            if block.settings.image != blank
              assign image_src = block.settings.image | image_url: width: 900
            else
              assign image_src = block.settings.fallback_asset | asset_url
            endif
          -%}
          <div
            class="barkin-mosaic-card barkin-mosaic-card--image"
            style="--barkin-mobile-mosaic-column: {{ mobile_image_column }};"
            data-carousel-slide
            {{ block.shopify_attributes }}
          >
            <img class="barkin-card-image" src="{{ image_src }}" alt="{{ block.settings.alt | escape }}" width="704" height="704" loading="lazy">
          </div>
        {% else %}
          {%- assign mobile_text_column = mobile_text_column | plus: 1 -%}
          <article
            class="barkin-mosaic-card barkin-mosaic-card--text"
            style="--barkin-mobile-mosaic-column: {{ mobile_text_column }};"
            {{ block.shopify_attributes }}
          >
            <h3 class="barkin-card-title">{{ block.settings.heading | newline_to_br }}</h3>
            <p class="barkin-copy">{{ block.settings.text }}</p>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if mobile_slide_count > 1 %}
      <div class="barkin-showcase__dots barkin-mosaic__dots" role="group" aria-label="{{ section.settings.pagination_label | escape }}">
        {%- assign mobile_dot_index = 0 -%}
        {% for block in section.blocks %}
          {% if block.type == 'image' or block.type == 'ingredient' %}
            <button
              class="barkin-showcase__dot{% if mobile_dot_index == 0 %} is-active{% endif %}"
              type="button"
              data-carousel-dot="{{ mobile_dot_index }}"
              aria-label="Ingredient {{ mobile_dot_index | plus: 1 }}"
              aria-controls="BarkinIngredientsRail-{{ section.id }}"
              aria-current="{% if mobile_dot_index == 0 %}true{% else %}false{% endif %}"
            >
              <span class="visually-hidden">{{ mobile_dot_index | plus: 1 }}</span>
            </button>
            {%- assign mobile_dot_index = mobile_dot_index | plus: 1 -%}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    </barkin-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Barkin ingredients",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "product_heading", "label": "Title from metafield", "info": "Connect a single-line text metafield using the dynamic source button. When empty, Heading below is used." },
    { "type": "richtext", "id": "product_text", "label": "Text from metafield", "info": "Connect a rich text metafield using the dynamic source button. When empty, Text below is used." },
    { "type": "textarea", "id": "heading", "label": "Fallback heading", "default": "Human Grade\nIngredients" },
    { "type": "textarea", "id": "text", "label": "Fallback text", "default": "Choosing premium ingredients helps support healthy skin and a beautiful coat." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn More" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "pagination_label", "label": "Pagination accessibility label", "default": "Choose ingredient slide" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "metaobject", "id": "ingredient", "label": "Ingredient", "metaobject_type": "human_grade_ingredients" },
        { "type": "header", "content": "Fallback content" },
        { "type": "image_picker", "id": "image", "label": "Fallback image" },
        { "type": "text", "id": "heading", "label": "Fallback title", "default": "Premium Grade Ingredient" },
        { "type": "richtext", "id": "text", "label": "Fallback text" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Design fallback",
          "default": "ingredient-honey.webp",
          "options": [
            { "value": "ingredient-honey.webp", "label": "Honey" },
            { "value": "ingredient-bubbles.webp", "label": "Bubbles" },
            { "value": "ingredient-dropper.webp", "label": "Dropper" },
            { "value": "ingredient-microscope.webp", "label": "Microscope" }
          ]
        },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Premium ingredient" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Premium Grade\nIngredient" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The care products you need to maintain impeccable hygiene and a healthy coat." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin ingredients",
      "blocks": [
        { "type": "image", "settings": { "fallback_asset": "ingredient-honey.webp" } },
        { "type": "text" },
        { "type": "image", "settings": { "fallback_asset": "ingredient-bubbles.webp" } },
        { "type": "text" },
        { "type": "text" },
        { "type": "image", "settings": { "fallback_asset": "ingredient-dropper.webp" } },
        { "type": "text" },
        { "type": "image", "settings": { "fallback_asset": "ingredient-microscope.webp" } }
      ]
    }
  ]
}
{% endschema %}
