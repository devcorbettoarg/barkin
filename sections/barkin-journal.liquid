{%- paginate blog.articles by section.settings.articles_per_page -%}
  <section class="barkin-journal" data-node-id="1:15744">
    <div class="barkin-shell">
      {%- if blog.all_tags.size > 0 -%}
        <nav class="barkin-journal__filters" aria-label="Filter journal articles">
          <a class="barkin-journal__filter{% if current_tags == blank %} is-active{% endif %}" href="{{ blog.url }}">All articles</a>
          {%- for tag in blog.all_tags -%}
            <a
              class="barkin-journal__filter{% if current_tags contains tag %} is-active{% endif %}"
              href="{{ blog.url }}/tagged/{{ tag | handle }}"
            >{{ tag }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <div class="barkin-journal__grid">
        {%- for article in blog.articles -%}
          {%- liquid
            if article.image != blank
              assign image_src = article.image | image_url: width: 1000
            else
              assign image_src = 'barkin/blog-feature.webp' | asset_url
            endif
            assign category = article.tags.first | default: 'Journal'
          -%}
          <article class="barkin-journal-card">
            <a class="barkin-journal-card__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
              <img src="{{ image_src }}" alt="{{ article.image.alt | default: article.title | escape }}" width="946" height="712" loading="lazy">
            </a>
            <div class="barkin-journal-card__body">
              <p class="barkin-journal-card__category">{{ category }}</p>
              <h2 class="barkin-journal-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <a class="barkin-button barkin-button--outline" href="{{ article.url }}">Read Article</a>
            </div>
            <div class="barkin-journal-card__meta">
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d/%m/%Y' }}</time>
              <span>Written by {{ article.author }}</span>
            </div>
          </article>
        {%- else -%}
          <p class="barkin-journal__empty">No articles have been published yet.</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Barkin journal",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "articles_per_page",
      "label": "Articles per page",
      "default": "12",
      "options": [
        { "value": "6", "label": "6" },
        { "value": "9", "label": "9" },
        { "value": "12", "label": "12" }
      ]
    }
  ],
  "presets": [{ "name": "Barkin journal" }]
}
{% endschema %}
