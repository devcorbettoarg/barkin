<script src="{{ 'barkin-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'barkin-problem-solver.js' | asset_url }}" defer="defer"></script>

<section class="barkin-section barkin-problem-solver" data-node-id="1:2649">
  <div class="barkin-shell">
    <header class="barkin-problem-solver__header">
      <div>
        <h2 class="barkin-title">{{ section.settings.heading | newline_to_br }}</h2>
      </div>
      <div class="barkin-problem-solver__intro">
        <p class="barkin-copy">{{ section.settings.text }}</p>
        {% if section.settings.button_label != blank %}
          <a class="barkin-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
    </header>

    <nav class="barkin-problem-solver__tabs" aria-label="{{ section.settings.tab_label | escape }}" role="tablist">
      {% for tab in section.blocks %}
        <button
          type="button"
          class="barkin-problem-solver__tab{% if forloop.first %} is-active{% endif %}"
          role="tab"
          data-problem-tab="{{ forloop.index0 }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          aria-controls="BarkinProblemPanel-{{ section.id }}-{{ forloop.index0 }}"
        >
          {{ tab.settings.tab }}
        </button>
      {% endfor %}
    </nav>

    <div class="barkin-problem-solver__panels">
      {% for block in section.blocks %}
        {%- liquid
          assign problem_collection = block.settings.collection
          if problem_collection == blank
            assign problem_collection = collections.all
          endif
        -%}
        <div
          id="BarkinProblemPanel-{{ section.id }}-{{ forloop.index0 }}"
          class="barkin-problem-solver__panel"
          data-problem-panel="{{ forloop.index0 }}"
          role="tabpanel"
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >
          <barkin-carousel class="barkin-problem-solver__carousel" role="region" aria-roledescription="carousel" aria-label="{{ block.settings.tab | escape }}">
            <div class="barkin-problem-solver__rail" data-carousel-rail>
              {% if problem_collection != blank and problem_collection.products.size > 0 %}
                {% for card_product in problem_collection.products limit: section.settings.products_per_tab %}
                  <article class="barkin-product-card" data-carousel-slide>
                    <a class="barkin-product-card__link" href="{{ card_product.url }}">
                      <span class="barkin-product-card__media">
                        {% if card_product.featured_image != blank %}
                          {{
                            card_product.featured_image
                            | image_url: width: 900
                            | image_tag: class: 'barkin-card-image', loading: 'lazy', widths: '360,540,720,900', alt: card_product.title
                          }}
                        {% endif %}
                      </span>
                      <span class="barkin-product-card__info">
                        <span class="barkin-product-card__title">{{ card_product.title }}</span>
                        <span class="barkin-product-card__price">{{ card_product.price | money }}</span>
                      </span>
                    </a>
                    <a class="barkin-product-card__bag" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
                      <img src="{{ 'barkin/add-bag.svg' | asset_url }}" alt="" width="18" height="19">
                    </a>
                  </article>
                {% endfor %}
              {% else %}
                {%- liquid
                  assign card_product = block.settings.product
                  if card_product != blank and card_product.featured_image != blank
                    assign card_image = card_product.featured_image | image_url: width: 900
                    assign card_title = card_product.title
                    assign card_price = card_product.price | money
                    assign card_url = card_product.url
                  else
                    assign card_image = block.settings.fallback_asset | asset_url
                    assign card_title = block.settings.product_title
                    assign card_price = block.settings.price
                    assign card_url = routes.all_products_collection_url
                  endif
                -%}
                <article class="barkin-product-card" data-carousel-slide>
                  <a class="barkin-product-card__link" href="{{ card_url }}">
                    <span class="barkin-product-card__media"><img class="barkin-card-image" src="{{ card_image }}" alt="{{ card_title | escape }}" width="704" height="942" loading="lazy"></span>
                    <span class="barkin-product-card__info"><span class="barkin-product-card__title">{{ card_title }}</span><span class="barkin-product-card__price">{{ card_price }}</span></span>
                  </a>
                  <a class="barkin-product-card__bag" href="{{ card_url }}" aria-label="{{ card_title | escape }}"><img src="{{ 'barkin/add-bag.svg' | asset_url }}" alt="" width="18" height="19"></a>
                </article>
              {% endif %}
            </div>
          </barkin-carousel>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Barkin problem solver",
  "tag": "section",
  "class": "section",
  "max_blocks": 7,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Products that solve any problem" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choosing the right shampoo for your dog’s coat type is essential to maintain both the health of their skin, while also making your life easier." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop All Products" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "tab_label", "label": "Tabs label", "default": "Shop by problem" },
    { "type": "text", "id": "carousel_label", "label": "Carousel label", "default": "Products by pet-care problem" },
    { "type": "range", "id": "products_per_tab", "min": 4, "max": 8, "step": 1, "label": "Products per tab", "default": 4 }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem",
      "settings": [
        { "type": "text", "id": "tab", "label": "Tab", "default": "Sensitive Skin" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "product", "id": "product", "label": "Fallback product" },
        { "type": "select", "id": "fallback_asset", "label": "Fallback image", "default": "barkin/product-black.webp", "options": [
          { "value": "barkin/product-black.webp", "label": "Black product" },
          { "value": "barkin/product-white.webp", "label": "White product" },
          { "value": "barkin/product-spray.webp", "label": "Spray product" },
          { "value": "barkin/product-dental.webp", "label": "Dental product" }
        ] },
        { "type": "text", "id": "product_title", "label": "Fallback product title", "default": "Gentle Care Shampoo" },
        { "type": "text", "id": "price", "label": "Fallback price", "default": "$19.95" }
      ]
    }
  ],
  "presets": [{ "name": "Barkin problem solver", "blocks": [
    { "type": "problem", "settings": { "tab": "Sensitive Skin" } },
    { "type": "problem", "settings": { "tab": "Dry & Flaky Skin", "fallback_asset": "barkin/product-white.webp" } },
    { "type": "problem", "settings": { "tab": "Itch & Irritation", "fallback_asset": "barkin/product-spray.webp" } },
    { "type": "problem", "settings": { "tab": "Shedding", "fallback_asset": "barkin/product-dental.webp" } },
    { "type": "problem", "settings": { "tab": "Tangles" } },
    { "type": "problem", "settings": { "tab": "Fleas & Ticks" } },
    { "type": "problem", "settings": { "tab": "Home Mess" } }
  ] }]
}
{% endschema %}
