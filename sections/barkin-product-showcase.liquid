<script src="{{ 'barkin-carousel.js' | asset_url }}" defer="defer"></script>

<section class="barkin-section barkin-showcase" data-node-id="20:1759">
  <div class="barkin-centered-intro">
    <h2 class="barkin-title">{{ section.settings.heading | newline_to_br }}</h2>
    <div class="barkin-copy">{{ section.settings.text }}</div>
    {% if section.settings.button_label != blank %}
      <a class="barkin-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

  <barkin-carousel
    class="barkin-showcase__carousel"
    data-initial-slide="{% if section.blocks.size > 4 %}1{% else %}0{% endif %}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.carousel_label | escape }}"
  >
    <div id="BarkinRail-{{ section.id }}" class="barkin-showcase__rail" data-carousel-rail>
      {% for block in section.blocks %}
        {%- liquid
          assign card_product = block.settings.product
          if card_product != blank and card_product.featured_image != blank
            assign card_image = card_product.featured_image | image_url: width: 900
            assign card_title = card_product.title
            assign card_price = card_product.price | money
            assign card_url = card_product.url
          elsif block.settings.image != blank
            assign card_image = block.settings.image | image_url: width: 900
            assign card_title = block.settings.title
            assign card_price = block.settings.price
            assign card_url = block.settings.link | default: routes.all_products_collection_url
          else
            assign card_image = block.settings.fallback_asset | asset_url
            assign card_title = block.settings.title
            assign card_price = block.settings.price
            assign card_url = block.settings.link | default: routes.all_products_collection_url
          endif
        -%}
        <article
          class="barkin-product-card"
          data-carousel-slide
          aria-label="{{ card_title | escape }}, {{ card_price | escape }}"
          {{ block.shopify_attributes }}
        >
          <a class="barkin-product-card__link" href="{{ card_url }}">
            <span class="barkin-product-card__media">
              <img class="barkin-card-image" src="{{ card_image }}" alt="{{ card_title | escape }}" width="704" height="942" loading="lazy">
            </span>
            <span class="barkin-product-card__info">
              <span class="barkin-product-card__title">{{ card_title }}</span>
              <span class="barkin-product-card__price">{{ card_price }}</span>
            </span>
          </a>

          {% if card_product != blank %}
            {%- form 'product', card_product, class: 'barkin-product-card__form' -%}
              <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
              <button
                class="barkin-product-card__bag"
                type="submit"
                aria-label="{{ 'products.product.add_to_cart' | t }}: {{ card_title | escape }}"
                {% unless card_product.available %}disabled{% endunless %}
              >
                <img src="{{ 'barkin/add-bag.svg' | asset_url }}" alt="" width="18" height="19">
              </button>
            {%- endform -%}
          {% else %}
            <a class="barkin-product-card__bag" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
              <img src="{{ 'barkin/add-bag.svg' | asset_url }}" alt="" width="18" height="19">
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="barkin-showcase__dots" role="group" aria-label="{{ section.settings.pagination_label | escape }}">
        {% for block in section.blocks limit: 5 %}
          <button
            class="barkin-showcase__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-carousel-dot="{{ forloop.index0 }}"
            aria-label="Mostrar producto {{ forloop.index }}"
            aria-controls="BarkinRail-{{ section.id }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="visually-hidden">{{ forloop.index }}</span>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </barkin-carousel>
</section>

{% schema %}
{
  "name": "Barkin product showcase",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Our Best Selling\nPremium Products." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Choosing the right shampoo for your dog’s coat type is essential to maintain both the health of their skin and the condition of their coat."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop All Items" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "carousel_label", "label": "Carousel accessibility label", "default": "Best selling products" },
    { "type": "text", "id": "pagination_label", "label": "Pagination accessibility label", "default": "Choose carousel position" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Fallback image from Shopify Files" },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Design fallback",
          "default": "barkin/product-black.webp",
          "options": [
            { "value": "barkin/product-black.webp", "label": "Black bottle" },
            { "value": "barkin/product-white.webp", "label": "White bottle" },
            { "value": "barkin/product-spray.webp", "label": "Spray bottle" },
            { "value": "barkin/product-dental.webp", "label": "Dental care" }
          ]
        },
        { "type": "text", "id": "title", "label": "Fallback title", "default": "Gentle Care Shampoo" },
        { "type": "text", "id": "price", "label": "Fallback price", "default": "$19.95" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin product showcase",
      "blocks": [
        { "type": "product", "settings": { "fallback_asset": "barkin/product-black.webp" } },
        { "type": "product", "settings": { "fallback_asset": "barkin/product-white.webp" } },
        { "type": "product", "settings": { "fallback_asset": "barkin/product-spray.webp" } },
        { "type": "product", "settings": { "fallback_asset": "barkin/product-dental.webp" } },
        { "type": "product", "settings": { "fallback_asset": "barkin/product-black.webp" } },
        { "type": "product", "settings": { "fallback_asset": "barkin/product-white.webp" } }
      ]
    }
  ]
}
{% endschema %}
