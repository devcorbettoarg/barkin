<section class="barkin-marquee" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div class="barkin-marquee__track">
    {% for repeat in (1..2) %}
      {% for block in section.blocks %}
        <div class="barkin-marquee__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | image_url: width: 70 }}" alt="" width="35" height="35" loading="lazy">
          {% else %}
            <img src="{{ 'cruelty-free.svg' | asset_url }}" alt="" width="35" height="35" loading="lazy">
          {% endif %}
          <span>{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Barkin promise banner",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Our promises" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "Choose an icon for this message. Leave empty to use the default cruelty-free icon." },
        { "type": "text", "id": "text", "label": "Text", "default": "Always Cruelty Free" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin promise banner",
      "blocks": [
        { "type": "promise" }, { "type": "promise" }, { "type": "promise" }, { "type": "promise" }
      ]
    }
  ]
}
{% endschema %}
