{{ 'barkin-theme.css' | asset_url | stylesheet_tag }}

<section class="barkin-marquee" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div class="barkin-marquee__track">
    {% for repeat in (1..2) %}
      {% for block in section.blocks %}
        <div class="barkin-marquee__item" {{ block.shopify_attributes }}>
          <img src="{{ 'barkin/cruelty-free.svg' | asset_url }}" alt="" width="35" height="35" loading="lazy">
          <span>{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Barkin promise banner",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Our promises" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Always Cruelty Free" }]
    }
  ],
  "presets": [
    {
      "name": "Barkin promise banner",
      "blocks": [
        { "type": "promise" }, { "type": "promise" }, { "type": "promise" }, { "type": "promise" }
      ]
    }
  ]
}
{% endschema %}
