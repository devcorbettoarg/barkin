<script src="{{ 'barkin-carousel.js' | asset_url }}" defer="defer"></script>

<section class="barkin-section barkin-review{% if section.settings.desktop_only %} barkin-desktop-only{% endif %}" data-node-id="20:1764">
  <div class="barkin-review__shell">
    <div class="barkin-review__summary">
      <div class="barkin-review__score-block">
        <div class="barkin-review__score"><strong>4.7</strong><span>(39 Reviews)</span></div>
        <div class="barkin-review__stars" aria-label="4.7 out of 5 stars">★★★★★</div>
        <p>100% of buyers would recommend this product.</p>
      </div>
      <div class="barkin-review__breakdown" aria-label="Review rating breakdown">
        {% assign rating_counts = '16,4,0,0,0' | split: ',' %}
        {% for count in rating_counts %}
          {% assign rating = 5 | minus: forloop.index0 %}
          <div class="barkin-review__breakdown-row">
            <span>{{ rating }}</span>
            <i style="--bar-width: {% if rating == 5 %}76{% elsif rating == 4 %}19{% else %}0{% endif %}%"></i>
            <span>{{ count }}</span>
          </div>
        {% endfor %}
      </div>
      <div class="barkin-review__actions">
        <button class="barkin-button" type="button">Filter Reviews</button>
        <button class="barkin-button" type="button">Write a Review</button>
      </div>
    </div>

    <div class="barkin-review__toolbar">
      <span>20 Reviews</span>
      <button type="button">Sort by: <strong>Photos &amp; Videos</strong></button>
    </div>

    <div id="BarkinReviewRail-{{ section.id }}" class="barkin-review-list" role="list">
      {% for block in section.blocks limit: 2 %}
        {%- liquid
          if block.settings.image != blank
            assign feature_image = block.settings.image | image_url: width: 1600
          else
            assign feature_image = 'barkin/review-feature.webp' | asset_url
          endif
          if block.settings.avatar != blank
            assign avatar_image = block.settings.avatar | image_url: width: 100
          else
            assign avatar_image = 'barkin/reviewer.webp' | asset_url
          endif
        -%}

        <article class="barkin-review-card" data-review-card {{ block.shopify_attributes }}>
          <div class="barkin-review-card__buyer">
            <img src="{{ avatar_image }}" alt="" width="34" height="34" loading="lazy">
            <div>
              <strong>{{ block.settings.name }}</strong>
              <span>{{ block.settings.buyer_label }}</span>
            </div>
          </div>
          <div class="barkin-review-card__copy">
            <div class="barkin-review__stars" aria-label="5 out of 5 stars">★★★★★</div>
            <h3>{{ block.settings.heading | newline_to_br }}</h3>
            <p>{{ block.settings.quote }}</p>
            <small>2 years ago</small>
          </div>
          <img class="barkin-review-card__photo" src="{{ feature_image }}" alt="{{ block.settings.image_alt | escape }}" width="118" height="118" loading="lazy">
          <div class="barkin-review-card__helpful">Was this helpful? <strong>4&nbsp;&nbsp;0</strong></div>
        </article>
      {% endfor %}
    </div>

    <button class="barkin-button barkin-review__load-more" type="button">Load More</button>
  </div>
</section>

{% schema %}
{
  "name": "Barkin featured reviews",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "desktop_only", "label": "Show only on desktop", "default": false },
    { "type": "text", "id": "carousel_label", "label": "Carousel accessibility label", "default": "Customer reviews" },
    { "type": "text", "id": "pagination_label", "label": "Pagination accessibility label", "default": "Choose customer review" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Feature image" },
        { "type": "text", "id": "image_alt", "label": "Image alt", "default": "Pet parents enjoying time with their dog" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Other Products That\nCompliment This One." },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Choosing the right care routine made a visible difference to our dog’s skin and coat." },
        { "type": "image_picker", "id": "avatar", "label": "Buyer avatar" },
        { "type": "text", "id": "name", "label": "Buyer name", "default": "Alessandra" },
        { "type": "text", "id": "buyer_label", "label": "Buyer label", "default": "Verified Buyer" },
        { "type": "text", "id": "recommendation", "label": "Recommendation", "default": "I recommend this product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin featured reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "name": "Marta" } },
        { "type": "review", "settings": { "name": "Daniel" } },
        { "type": "review", "settings": { "name": "Sofia" } },
        { "type": "review", "settings": { "name": "Alex" } }
      ]
    }
  ]
}
{% endschema %}
