<script src="{{ 'barkin-carousel.js' | asset_url }}" defer="defer"></script>

<section class="barkin-section barkin-social" data-node-id="20:1767">
  <div class="barkin-centered-intro">
    <h2 class="barkin-title">{{ section.settings.heading | newline_to_br }}</h2>
    <p class="barkin-copy">{{ section.settings.text }}</p>
    {% if section.settings.button_label != blank %}
      <a class="barkin-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
  <barkin-carousel
    class="barkin-social__carousel"
    data-initial-slide="{% if section.blocks.size > 4 %}1{% else %}0{% endif %}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.carousel_label | escape }}"
  >
    <div class="barkin-social__rail" data-carousel-rail>
      {% for block in section.blocks %}
        {%- liquid
          if block.settings.image != blank
            assign image_src = block.settings.image | image_url: width: 900
          else
            assign image_src = block.settings.fallback_asset | asset_url
          endif
        -%}
        <a
          class="barkin-social__item"
          href="{{ block.settings.link | default: section.settings.button_link | default: routes.root_url }}"
          data-carousel-slide
          {{ block.shopify_attributes }}
        >
          <img class="barkin-card-image" src="{{ image_src }}" alt="{{ block.settings.alt | escape }}" width="704" height="942" loading="lazy">
        </a>
      {% endfor %}
    </div>
  </barkin-carousel>
</section>

{% schema %}
{
  "name": "Barkin social gallery",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "We’re Social, Come\nConnect With Us." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join our community of discerning pets and their parents." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Connect With Us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "carousel_label", "label": "Carousel accessibility label", "default": "Barkin and Meowson social gallery" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "fallback_asset", "label": "Design fallback", "default": "barkin/social-1.webp", "options": [{ "value": "barkin/social-1.webp", "label": "Social 1" }, { "value": "barkin/social-2.webp", "label": "Social 2" }, { "value": "barkin/social-3.webp", "label": "Social 3" }, { "value": "barkin/social-4.webp", "label": "Social 4" }] },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Barkin & Meowson community" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin social gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image", "settings": { "fallback_asset": "barkin/social-2.webp" } },
        { "type": "image", "settings": { "fallback_asset": "barkin/social-3.webp" } },
        { "type": "image", "settings": { "fallback_asset": "barkin/social-4.webp" } },
        { "type": "image", "settings": { "fallback_asset": "barkin/social-1.webp" } },
        { "type": "image", "settings": { "fallback_asset": "barkin/social-2.webp" } }
      ]
    }
  ]
}
{% endschema %}
