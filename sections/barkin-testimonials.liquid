<script src="{{ 'barkin-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign initial_testimonial = 0
  if section.blocks.size > 2
    assign initial_testimonial = 1
  endif
-%}

<section class="barkin-testimonials" data-node-id="20:1764">
  <header class="barkin-testimonials__header">
    <h2 class="barkin-title">{{ section.settings.heading | newline_to_br }}</h2>
    {% if section.settings.text != blank %}
      <p class="barkin-copy">{{ section.settings.text }}</p>
    {% endif %}
  </header>

  <barkin-carousel
    class="barkin-testimonials__carousel"
    data-initial-slide="{{ initial_testimonial }}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.carousel_label | escape }}"
  >
    <div id="BarkinTestimonialsRail-{{ section.id }}" class="barkin-testimonials__rail" data-carousel-rail>
      {% for block in section.blocks %}
        {%- liquid
          if block.settings.image != blank
            assign feature_image = block.settings.image | image_url: width: 1200
          else
            assign feature_image = 'barkin/review-feature.webp' | asset_url
          endif
          if block.settings.avatar != blank
            assign avatar_image = block.settings.avatar | image_url: width: 100
          else
            assign avatar_image = 'barkin/reviewer.webp' | asset_url
          endif
        -%}

        <article class="barkin-testimonial{% if forloop.index0 == initial_testimonial %} is-active{% else %} is-edge{% endif %}" data-carousel-slide {{ block.shopify_attributes }}>
          <div class="barkin-testimonial__image">
            <img src="{{ feature_image }}" alt="{{ block.settings.image_alt | escape }}" width="960" height="1000" loading="lazy">
          </div>
          <div class="barkin-testimonial__content">
            <div class="barkin-testimonial__quote">
              <span aria-hidden="true">“</span>
              <p>{{ block.settings.quote }}</p>
            </div>
            <div class="barkin-testimonial__buyer">
              <div class="barkin-testimonial__buyer-row">
                <img src="{{ avatar_image }}" alt="" width="34" height="34" loading="lazy">
                <div>
                  <strong>{{ block.settings.name }}</strong>
                  <small>{{ block.settings.buyer_label }}</small>
                </div>
              </div>
              {% if block.settings.recommendation != blank %}
                <p>
<svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1.71915 3.72571V8.51591H0.862236C0.383216 8.51591 0 8.1327 0 7.659V4.58795C0 4.11425 0.388539 3.72571 0.862236 3.72571H1.71915ZM7.71222 2.92735H5.16809V1.06449C5.16809 0.47902 4.68907 0 4.10892 0H4.06102C3.84812 0 3.65652 0.127739 3.57136 0.324669L2.11833 3.72571V8.51591H7.01498C7.40352 8.51591 7.73351 8.23915 7.8027 7.85593L8.50526 3.8641C8.59042 3.37443 8.21785 2.92735 7.71754 2.92735H7.71222Z" fill="#FFFDFC" fill-opacity="0.5"/>
</svg>
 {{ block.settings.recommendation }}</p>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="barkin-showcase__dots barkin-testimonials__dots" role="group" aria-label="{{ section.settings.pagination_label | escape }}">
        {% for block in section.blocks %}
          <button
            class="barkin-showcase__dot{% if forloop.index0 == initial_testimonial %} is-active{% endif %}"
            type="button"
            data-carousel-dot="{{ forloop.index0 }}"
            aria-label="Mostrar reseña {{ forloop.index }}"
            aria-controls="BarkinTestimonialsRail-{{ section.id }}"
            aria-current="{% if forloop.index0 == initial_testimonial %}true{% else %}false{% endif %}"
          >
            <span class="visually-hidden">{{ forloop.index }}</span>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </barkin-carousel>
</section>

{% schema %}
{
  "name": "Barkin testimonials",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "See What People Say\nAbout Barkin&Meowson" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Real experiences from pet parents who made Barkin&Meowson part of their care routine." },
    { "type": "text", "id": "carousel_label", "label": "Carousel accessibility label", "default": "Customer reviews" },
    { "type": "text", "id": "pagination_label", "label": "Pagination accessibility label", "default": "Choose customer review" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Feature image" },
        { "type": "text", "id": "image_alt", "label": "Image alt", "default": "Pet parents enjoying time with their dog" },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Choosing the right shampoo for your dog’s coat type is essential to maintain both the health of their skin and the condition of their coat, while also making your life easier." },
        { "type": "image_picker", "id": "avatar", "label": "Buyer avatar" },
        { "type": "text", "id": "name", "label": "Buyer name", "default": "Alessandra" },
        { "type": "text", "id": "buyer_label", "label": "Buyer label", "default": "Pet Owner" },
        { "type": "text", "id": "recommendation", "label": "Purchase label", "default": "Purchased the Detangling Spray" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "name": "Marta" } },
        { "type": "review", "settings": { "name": "Daniel" } },
        { "type": "review", "settings": { "name": "Sofia" } },
        { "type": "review", "settings": { "name": "Alex" } }
      ]
    }
  ]
}
{% endschema %}
