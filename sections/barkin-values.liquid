<section class="barkin-section barkin-values" data-node-id="28:8100">
  <div class="barkin-shell">
    <header class="barkin-values__header">
      <h2 class="barkin-title">{{ section.settings.heading | newline_to_br }}</h2>
      {% if section.settings.text != blank %}
        <p class="barkin-copy">{{ section.settings.text }}</p>
      {% endif %}
    </header>

    <div class="barkin-values__grid">
      {% for block in section.blocks %}
        <article class="barkin-value" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="barkin-value__media">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '360,540,720,960,1200',
                  sizes: '(min-width: 750px) 45vw, 100vw',
                  alt: block.settings.image.alt
              }}
            </div>
          {% endif %}

          <div class="barkin-value__content">
            <span class="barkin-value__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
            <div>
              <h3 class="barkin-card-title">{{ block.settings.heading }}</h3>
              {% if block.settings.text != blank %}
                <p class="barkin-copy barkin-muted">{{ block.settings.text }}</p>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Barkin non-negotiables",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Our\nNon-Negotiables." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The standards behind every product we make and every choice we take." }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Pet-first care." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every detail starts with the wellbeing and comfort of pets." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barkin non-negotiables",
      "blocks": [
        { "type": "value" },
        { "type": "value", "settings": { "heading": "Premium ingredients.", "text": "Thoughtfully selected ingredients for considered everyday care." } },
        { "type": "value", "settings": { "heading": "No shortcuts.", "text": "Purposeful formulas made to meet the standards we expect for our own pets." } },
        { "type": "value", "settings": { "heading": "Kind by design.", "text": "Cruelty-free care shaped by respect for animals and the world around them." } }
      ]
    }
  ]
}
{% endschema %}
