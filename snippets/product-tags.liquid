{%- assign product_tags = product.metafields.custom.tags.value -%}

{%- if product_tags != blank -%}
  <div class="barkin-product-tags" {{ block.shopify_attributes }}>
    <div
      class="barkin-product-tags__list"
      role="list"
      aria-label="Product tags"
    >
      {%- for tag in product_tags -%}
        {%- assign tag_label = tag | strip -%}

        {%- if tag_label != blank -%}
          <span
            class="barkin-product-tags__pill"
            role="listitem"
          >
            {{ tag_label | escape }}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}