        },
        "faq_3": {
          "type": "question",
          "settings": {
            "category": "",
            "question": "Как да избера подходящата грижа?",
            "answer": "<p>Попълнете продуктовия ни въпросник или разгледайте продуктите според типа козина и състоянието на кожата, за да създадете подходяща грижа за своя любимец.</p>"
          }
        },
        "faq_4": {
          "type": "question",
